client
dev tun
proto tcp

# Multi-endpoint (Load Balancing)

remote 31.171.155.6 443

setenv FRIENDLY_NAME "(India4)@Vpn_m2s"

remote-random
remote-cert-tls server
nobind
persist-key
persist-tun
reneg-sec 0
cipher AES-256-CBC
auth SHA512
verb 3

<auth-user-pass>
8nmTPCnAPy
yJAK6fc3za
</auth-user-pass>

# ================================
#      Anti-Reset / Anti-Drop
# ================================
connect-retry-max 9999
connect-retry 1 2
connect-timeout 5
inactive 0
ping 5
ping-restart 20
setenv SAFE_RESTART 1
mute-replay-warnings
explicit-exit-notify 1



# ================================
#       Adaptive MTU (AI Mode)
# ================================
mssfix 0
tun-mtu 1500

sndbuf 524288
rcvbuf 524288
push-peer-info
setenv MTU_ADAPTIVE 1

