# =============================================================================
# v2get — deployment configuration
# =============================================================================
# Copy this file to `.env` and fill in the values you need:
#
#     cp .env.example .env
#
# Everything here is read ONCE at startup, because it is intrinsic to the
# deployment (secrets and paths). All *tunable* behaviour — scan interval, pool
# size, TCP timeout, cooldown length, output formats — lives in the database and
# is edited from the dashboard Settings page, applying instantly with no restart.
#
# Every variable below is OPTIONAL. With an empty .env the app still boots,
# serves the dashboard and manages existing configs; it simply won't collect
# from Telegram or publish to GitHub until you configure those sections.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# Telegram collection
# ─────────────────────────────────────────────────────────────────────────────
# Telegram bots CANNOT read arbitrary public-channel history, so collection
# requires a logged-in *user* account session rather than a bot token.
#
# Step 1 — get an api_id / api_hash pair (free) at:
#            https://my.telegram.org  →  API development tools
# Step 2 — mint a StringSession from those credentials:
#            pip install telethon
#            python -m app.tools.gen_session
#          It prompts for your phone number and the login code, then prints the
#          session string. Run it on your own machine, not inside the container.

# Numeric application ID from my.telegram.org. Leave blank to disable collection.
TELEGRAM_API_ID=

# Application hash string from my.telegram.org. Treat it like a password.
TELEGRAM_API_HASH=

# The StringSession printed by `python -m app.tools.gen_session`.
# SECURITY: this grants FULL access to the Telegram account it was minted from.
# Never commit it, never share it. Revoke it from Telegram → Settings → Devices
# if it is ever exposed.
TELEGRAM_SESSION=


# ─────────────────────────────────────────────────────────────────────────────
# GitHub publishing (optional)
# ─────────────────────────────────────────────────────────────────────────────
# After each run, v2get pushes the generated subscription files to a GitHub repo
# so clients can fetch them from a stable raw URL. A commit is only made when
# the published content actually changed, so idle runs create no history noise.
#
# These four values seed the database on first boot; afterwards they can be
# changed from the dashboard Settings page and the stored values take priority.

# Personal Access Token. Required scopes:
#   • classic PAT       → `repo`
#   • fine-grained PAT  → Repository permissions → Contents: Read and write
# Leave blank to disable publishing entirely.
GITHUB_TOKEN=

# Destination repository in `owner/repo` form, e.g. octocat/my-subscriptions.
GITHUB_REPOSITORY=

# Branch to commit to.
GITHUB_BRANCH=main

# Optional subdirectory inside the repo, e.g. `sub` publishes to sub/active.txt.
# Leave blank to publish at the repository root.
GITHUB_TARGET_DIR=


# ─────────────────────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────────────────────
# Root directory for ALL persistent state: the SQLite database, generated
# output files, blacklists and rotating logs. In Docker this is a mounted
# volume, so container restarts and rebuilds never lose data.
#
#   Docker  → /data   (already set by the image; docker-compose mounts ./data)
#   Local   → ./data
DATA_DIR=/data


# ─────────────────────────────────────────────────────────────────────────────
# Dashboard authentication (optional but STRONGLY recommended)
# ─────────────────────────────────────────────────────────────────────────────
# Protects the dashboard and the whole REST API with HTTP Basic auth.
# `/api/health` stays public so container healthchecks and uptime monitors work.
#
# Leave ALL THREE blank to disable auth — only acceptable when the port is bound
# to localhost or a private network. Never expose an unauthenticated dashboard
# to the internet: it can read your collected configs and rewrite your settings.
#
# HTTP Basic sends base64(user:password) on every request. That is an encoding,
# not encryption, so ALWAYS put v2get behind HTTPS (Caddy/Nginx) when it is
# reachable from the internet.

# Login username.
DASHBOARD_USER=

# PREFERRED: a salted PBKDF2-HMAC-SHA256 digest, never the password itself.
# Generate one with:
#     python -m app.tools.hash_password
# It prints a ready-to-paste `DASHBOARD_PASSWORD_HASH=pbkdf2_sha256$...` line.
DASHBOARD_PASSWORD_HASH=

# LEGACY FALLBACK: plaintext password, used only when the hash above is blank.
# Kept for backwards compatibility with older deployments. Prefer the hash —
# a plaintext secret at rest is recoverable by anyone who can read this file.
DASHBOARD_PASSWORD=
